{
  "name": "@ramp/angular-editor",
  "version": "3.0.0-beta.13",
  "description": "A simple native WYSIWYG editor for Angular 19+. Rich Text editor component for Angular",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "build": "nx build angular-editor-app",
    "build-prod": "ng build angular-editor-app --configuration production",
    "test": "nx test",
    "lint:lib": "nx lint angular-editor",
    "lint": "npx eslint projects",
    "eslint": "npx eslint projects",
    "build-watch:lib": "nx build angular-editor --watch",
    "test:lib": "nx test angular-editor",
    "build:lib": "ng-packagr -p projects/angular-editor/ng-package.json",
    "build-prod:lib": "ng-packagr -p projects/angular-editor/ng-package.json -c projects/angular-editor/tsconfig.lib.prod.json",
    "publish:lib": "npm run copy:readme && npm run copy:changelog && npm run copy:license && npm publish ./dist/angular-editor --tag next",
    "copy:readme": "xcopy README.md dist\\angular-editor",
    "copy:changelog": "xcopy CHANGELOG.md dist\\angular-editor",
    "copy:license": "xcopy LICENSE dist\\angular-editor",
    "test-ci": "nx test angular-editor --code-coverage --no-watch --browsers=ChromeHeadless && cat ./coverage/angular-editor/lcov.info | coveralls"
  },
  "private": true,
  "dependencies": {
    "@angular-eslint/builder": "^20.1.1",
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/eslint-plugin-template": "^20.1.1",
    "@angular-eslint/schematics": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@angular/animations": "^20.0.6",
    "@angular/cli": "^20.0.5",
    "@angular/common": "^20.0.6",
    "@angular/compiler": "^20.0.6",
    "@angular/compiler-cli": "^20.0.6",
    "@angular/core": "^20.0.6",
    "@angular/forms": "^20.0.6",
    "@angular/language-service": "^20.0.6",
    "@angular/platform-browser": "^20.0.6",
    "@angular/platform-browser-dynamic": "^20.0.6",
    "@angular/router": "^20.0.6",
    "@fortawesome/angular-fontawesome": "^2.0.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@nx/workspace": "^21.2.2",
    "@schematics/angular": "^20.0.5",
    "@smarttools/eslint-plugin-rxjs": "^1.0.20",
    "@types/jasmine": "^5.1.8",
    "@types/jasminewd2": "^2.0.13",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-rxjs-updated": "^1.0.50",
    "ng-packagr": "^20.0.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.5",
    "@angular-devkit/core": "^20.0.5",
    "@angular-devkit/schematics": "^20.0.5",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "globals": "^16.3.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.6",
    "@esbuild/win32-x64": "^0.25.6",
    "@nx/nx-darwin-arm64": "^21.2.2",
    "@nx/nx-darwin-x64": "^21.2.2",
    "@nx/nx-linux-x64-gnu": "^21.2.2",
    "@nx/nx-win32-x64-msvc": "^21.2.2"
  },
  "overrides": {
    "eslint": {
      "file-entry-cache": {
        "flat-cache": {
          "rimraf@^3.0.2": "^5.0.10"
        }
      }
    }
  }
}
