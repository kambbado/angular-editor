{
  "name": "@ramp/angular-editor",
  "version": "3.0.0-beta.16",
  "scripts": {
    "ng": "ng",
    "start": "nx serve angular-editor-app",
    "build": "cross-env CI=true NX_NO_CLOUD=true nx build angular-editor-app",
    "build:app": "cross-env CI=true NX_NO_CLOUD=true nx build angular-editor-app",
    "build:app:prod": "cross-env CI=true NX_NO_CLOUD=true nx build angular-editor-app --configuration production",
    "build-prod": "npm run build:app:prod",
    "test": "nx test",
    "lint:lib": "nx lint angular-editor",
    "lint": "npx eslint projects",
    "eslint": "npx eslint projects",
    "build-watch:lib": "nx build angular-editor --watch",
    "test:lib": "nx test angular-editor",
    "build:lib": "cross-env CI=true NX_NO_CLOUD=true nx build angular-editor",
    "build:lib:prod": "cross-env CI=true NX_NO_CLOUD=true nx build angular-editor --configuration production",
    "build-prod:lib": "npm run build:lib:prod",
    "build:all": "cross-env CI=true NX_NO_CLOUD=true nx run-many -t build -p angular-editor,angular-editor-app",
    "publish:lib": "npm run build-prod:lib && npm run copy:readme && npm run copy:changelog && npm run copy:license && npm publish ./dist/angular-editor --tag latest --registry=https://pkgs.dev.azure.com/modramp/_packaging/npmjs-library-202503/npm/registry/",
    "copy:readme": "cpx README.md dist/angular-editor",
    "copy:changelog": "cpx CHANGELOG.md dist/angular-editor",
    "copy:license": "cpx LICENSE dist/angular-editor",
    "test-ci": "nx test angular-editor --coverage --watch=false && cat ./coverage/angular-editor/lcov.info | coveralls"
  },
  "private": true,
