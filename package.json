{
  "name": "@ramp/angular-editor",
  "version": "3.0.0-beta.14",
  "description": "A simple native WYSIWYG editor for Angular 21+. Rich Text editor component for Angular",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "build": "nx build angular-editor-app",
    "build-prod": "ng build angular-editor-app --configuration production",
    "test": "nx test",
    "lint:lib": "nx lint angular-editor",
    "lint": "npx eslint projects",
    "eslint": "npx eslint projects",
    "build-watch:lib": "nx build angular-editor --watch",
    "test:lib": "nx test angular-editor",
    "build:lib": "ng-packagr -p projects/angular-editor/ng-package.json",
    "build-prod:lib": "ng-packagr -p projects/angular-editor/ng-package.json -c projects/angular-editor/tsconfig.lib.prod.json",
    "publish:lib": "npm run copy:readme && npm run copy:changelog && npm run copy:license && npm publish ./dist/angular-editor --tag next",
    "copy:readme": "xcopy README.md dist\\angular-editor",
    "copy:changelog": "xcopy CHANGELOG.md dist\\angular-editor",
    "copy:license": "xcopy LICENSE dist\\angular-editor",
    "test-ci": "nx test angular-editor --code-coverage --no-watch --browsers=ChromeHeadless && cat ./coverage/angular-editor/lcov.info | coveralls"
  },
  "private": true,
  "dependencies": {
    "@angular-eslint/builder": "^21.1.0",
    "@angular-eslint/eslint-plugin": "^21.1.0",
    "@angular-eslint/eslint-plugin-template": "^21.1.0",
    "@angular-eslint/schematics": "^21.1.0",
    "@angular-eslint/template-parser": "^21.1.0",
    "@angular/animations": "^21.0.8",
    "@angular/common": "^21.0.8",
    "@angular/core": "^21.0.8",
    "@angular/forms": "^21.0.8",
    "@angular/platform-browser": "^21.0.8",
    "@angular/platform-browser-dynamic": "^21.0.8",
    "@angular/router": "^21.0.8",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.5",
    "@angular-devkit/core": "^21.0.5",
    "@angular-devkit/schematics": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler": "^21.0.8",
    "@angular/compiler-cli": "^21.0.8",
    "@angular/language-service": "^21.0.8",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@schematics/angular": "^21.0.5",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@types/jasmine": "^5.1.15",
    "@types/jasminewd2": "^2.0.13",
    "@types/node": "^25.0.7",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@typescript-eslint/types": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-rxjs-updated": "^1.0.50",
    "globals": "^17.0.0",
    "ng-packagr": "^21.0.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.27.2",
    "@esbuild/win32-x64": "^0.27.2",
    "@nx/nx-darwin-arm64": "^22.3.3",
    "@nx/nx-darwin-x64": "^22.3.3",
    "@nx/nx-linux-x64-gnu": "^22.3.3",
    "@nx/nx-win32-x64-msvc": "^22.3.3"
  },
  "overrides": {
    "eslint": {
      "file-entry-cache": {
        "flat-cache": {
          "rimraf@^3.0.2": "^5.0.10"
        }
      }
    }
  }
}
