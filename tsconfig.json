{
  "$schema": "http://json.schemastore.org/tsconfig",
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "composite": false,
    "noFallthroughCasesInSwitch": true,
    "pretty": true,
    "rootDir": ".",
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "preserveSymlinks": true,
    "skipLibCheck": true,
    "target": "es2022",
    "module": "es2022",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2022", "dom"],
    "resolveJsonModule": true,
    "preserveConstEnums": true,
    "incremental": true,
    "paths": {
      "angular-editor": ["./projects/angular-editor/src/public-api.ts"]
    }
  },
  "include": ["src", "projects"],
  "exclude": ["**/*.spec.ts", "./node_modules/*", "dist"],
  "angularCompilerOptions": {
    "annotateForClosureCompiler": true,
    "strictTemplates": true,
    "strictInputTypes": true,
    "strictNullInputTypes": true,
    "strictAttributeTypes": true,
    "strictSafeNavigationTypes": true,
    "strictDomLocalRefTypes": true,
    "strictOutputEventTypes": true,
    "strictDomEventTypes": true,
    "strictContextGenerics": true,
    "strictLiteralTypes": true,
    "allowEmptyCodegenFiles": true,
    "genDir": "../../dist",
    "isolatedModules": false,
    "fullTemplateTypeCheck": true,
    "strictInjectionParameters": true,
    "enableI18nLegacyMessageIdFormat": false,
    "strictInputAccessModifiers": true,
    "esModuleInterop": true
  },
  "references": [
    {
      "path": "./tsconfig.eslint.json"
    },
    {
      "path": "./projects/angular-editor/tsconfig.eslint.json"
    },
    {
      "path": "./projects/angular-editor-app/tsconfig.eslint.json"
    }
  ]
}
